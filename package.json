{
  "name": "particle-rose-to-gu",
  "version": "4.0.0",
  "private": true,
  "description": "GPU particle bouquet confession for 故辞安",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "start": "electron .",
    "dist:win": "npm run build:web && electron-builder --win portable --x64"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "vite": "7.1.3"
  },
  "build": {
    "appId": "com.soullink.togucian",
    "productName": "to_故辞安",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "to_故辞安.exe"
    }
  }
}
